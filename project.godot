config_version=5

[application]

config/name="OfficeTest"
run/main_scene="uid://btux4vr61q4gb"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*uid://duh5kkxnlh7vh"
CameraRegistry="*uid://sa17ou5lwwbf"
Night="*uid://dxor37wmh26iq"
